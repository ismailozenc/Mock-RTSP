<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>MockRtsp</AssemblyName>
    <RootNamespace>MockRtsp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- If the project folder has mediamtx\ and ffmpeg\ folders, copy them next to MockRtsp.exe on build. -->
  <ItemGroup Condition="Exists('mediamtx')">
    <None Include="mediamtx\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('ffmpeg')">
    <None Include="ffmpeg\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
